{
  "name": "scion",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "scion": "./src/index.tsx"
  },
  "scripts": {
    "start": "tsx src/index.tsx",
    "server": "tsx src/server/index.ts",
    "web": "bun run --cwd web build && tsx src/server/index.ts",
    "web:dev": "tsx scripts/web-dev.ts",
    "web:smoke": "tsx scripts/run-isolated.ts scripts/web-smoke.ts",
    "db:generate": "drizzle-kit generate",
    "uninstall-hooks": "tsx scripts/uninstall-hooks.ts",
    "smoke": "tsx scripts/run-isolated.ts scripts/smoke.ts",
    "daemon-smoke": "tsx scripts/run-isolated.ts scripts/daemon-smoke.ts",
    "persistence-smoke": "tsx scripts/run-isolated.ts scripts/persistence-smoke.ts",
    "test": "vitest run && bun run --cwd web test",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "1.19.13",
    "@hono/node-ws": "1.3.0",
    "better-sqlite3": "12.6.2",
    "drizzle-orm": "0.45.2",
    "friendly-words": "1.3.1",
    "hono": "4.12.25",
    "ink": "5.2.1",
    "ink-text-input": "6.0.0",
    "node-pty": "1.1.0",
    "react": "18.3.1",
    "simple-git": "3.36.0",
    "strip-ansi": "^7.2.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.10.2",
    "@types/react": "18.3.18",
    "@vitest/coverage-v8": "^4",
    "drizzle-kit": "0.31.8",
    "jsdom": "^27",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "^4"
  },
  "trustedDependencies": ["better-sqlite3", "esbuild", "node-pty"]
}
